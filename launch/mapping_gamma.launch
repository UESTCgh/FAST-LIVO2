<launch>
	<arg name="rviz" default="true" />
	<arg name="lio_bievr" default="true" />
	<arg name="vio" default="true" />
	<arg name="save_map" default="false" />
	<arg name="map_dir" default="" />
	<arg name="seq_name" default="" />
	<arg name="lio_quality_log" default="" />
	<arg name="bievr" default="false" />
	<arg name="bag" default="" />
	<arg name="bievr_params" default="params" />

	<group unless="$(arg bievr)">
		<rosparam command="load" file="$(find fast_livo)/config/gamma.yaml" />
		<param name="common/img_en" type="int" value="$(eval 1 if arg('vio') else 0)" />
		<param if="$(arg save_map)" name="pcd_save/pcd_save_en" type="bool" value="true" />
		<param if="$(eval arg('map_dir') != '')" name="pcd_save/output_dir" type="str" value="$(arg map_dir)" />
		<param name="lio/residual_type" type="str" value="$(eval 'bievr' if arg('lio_bievr') else 'point_to_plane')" />
		<param if="$(arg lio_bievr)" name="preprocess/feature_extract_enabled" type="bool" value="false" />
		<param if="$(arg lio_bievr)" name="preprocess/blind" type="double" value="2.0" />
		<param if="$(eval arg('seq_name') != '')" name="evo/seq_name" type="str" value="$(arg seq_name)" />
		<param if="$(eval arg('lio_quality_log') != '')" name="lio_quality/log_en" type="bool" value="$(arg lio_quality_log)" />

		<node pkg="fast_livo" type="fastlivo_mapping" name="laserMapping" output="screen">
			<rosparam if="$(eval arg('vio') or not arg('lio_bievr'))" file="$(find fast_livo)/config/camera_gamma.yaml" />
		</node>

		<group if="$(arg rviz)">
			<node launch-prefix="nice" pkg="rviz" type="rviz" name="rviz" args="-d $(find fast_livo)/rviz_cfg/fast_livo2.rviz" />
		</group>

		<node if="$(arg vio)" pkg="image_transport" type="republish" name="republish" args="compressed in:=/left_camera/image raw out:=/left_camera/image" output="screen" respawn="true"/>
	</group>

	<group if="$(arg bievr)">
		<include if="$(eval arg('bag') == '')" file="$(find bievr_lio_ros)/launch/process_topics.launch">
			<arg name="sensor_config" value="gamma" />
			<arg name="params" value="$(arg bievr_params)" />
			<arg name="rviz" value="$(arg rviz)" />
		</include>

		<include if="$(eval arg('bag') != '')" file="$(find bievr_lio_ros)/launch/process_bag.launch">
			<arg name="sensor_config" value="gamma" />
			<arg name="params" value="$(arg bievr_params)" />
			<arg name="rosbag" value="$(arg bag)" />
			<arg name="rviz" value="$(arg rviz)" />
		</include>
	</group>
</launch>
