<launch>
	<arg name="event_timing" default="true" />
	<arg name="robust_vision" default="true" />
	<arg name="scan_diagnostics" default="true" />
	<arg name="visual_feedback" default="true" />
	<arg name="rviz" default="true" />
	<arg name="save_map" default="false" />
	<arg name="map_dir" default="" />
	<arg name="seq_name" default="Retail_Street_multicam_event" />
	<arg name="lio_quality_log" default="" />

	<rosparam command="load" file="$(find fast_livo)/config/avia.yaml" />
	<rosparam command="load" file="$(find fast_livo)/config/retail_multicam.yaml" />
	<rosparam command="load" ns="multi_camera/left" file="$(find fast_livo)/config/camera_pinhole.yaml" />
	<param name="multi_camera/event_timing" type="bool" value="$(arg event_timing)" />
	<param name="multi_camera/robust_vision" type="bool" value="$(arg robust_vision)" />
	<param name="multi_camera/scan_diagnostics" type="bool" value="$(arg scan_diagnostics)" />
	<param name="multi_camera/visual_feedback" type="bool" value="$(arg visual_feedback)" />
	<param name="evo/seq_name" type="str" value="$(arg seq_name)" />
	<param if="$(arg save_map)" name="pcd_save/pcd_save_en" type="bool" value="true" />
	<param if="$(eval arg('map_dir') != '')" name="pcd_save/output_dir" type="str" value="$(arg map_dir)" />
	<param if="$(eval arg('lio_quality_log') != '')" name="lio_quality/log_en" type="bool" value="$(arg lio_quality_log)" />

	<node pkg="fast_livo" type="fastlivo_mapping" name="laserMappingMulticam" output="screen">
		<param name="multi_camera_enabled" type="bool" value="true" />
	</node>
	<node if="$(arg rviz)" launch-prefix="nice" pkg="rviz" type="rviz" name="rviz" args="-d $(find fast_livo)/rviz_cfg/fast_livo2.rviz" />
</launch>
