<launch>
	<arg name="camera_mode" default="both" />
	<arg name="multicam_config" default="$(find fast_livo)/config/camera/gamma_multicam.yaml" />
	<arg name="visual_feedback" default="true" />
	<arg name="right_feedback_gain" default="0.12" />
	<arg name="rviz" default="true" />
	<arg name="save_map" default="false" />
	<arg name="map_dir" default="" />
	<arg name="seq_name" default="$(eval 'gamma_multicam_' + arg('camera_mode'))" />
	<arg name="lio_quality_log" default="" />

	<rosparam command="load" file="$(find fast_livo)/config/gamma.yaml" />
	<rosparam command="load" file="$(arg multicam_config)" />
	<rosparam param="multi_camera/cameras" subst_value="true">$(eval {'left': ['left'], 'right': ['right'], 'both': ['left', 'right']}[arg('camera_mode')])</rosparam>
	<param name="multi_camera/visual_feedback" type="bool" value="$(arg visual_feedback)" />
	<param if="$(eval arg('camera_mode') == 'right')" name="multi_camera/feedback_gain"
	       type="double" value="$(arg right_feedback_gain)" />
	<param name="common/img_en" type="int" value="1" />
	<param name="lio/residual_type" type="str" value="bievr" />
	<param name="preprocess/feature_extract_enabled" type="bool" value="false" />
	<param name="preprocess/blind" type="double" value="2.0" />
	<param name="evo/seq_name" type="str" value="$(arg seq_name)" />
	<param if="$(arg save_map)" name="pcd_save/pcd_save_en" type="bool" value="true" />
	<param if="$(eval arg('map_dir') != '')" name="pcd_save/output_dir" type="str" value="$(arg map_dir)" />
	<param if="$(eval arg('lio_quality_log') != '')" name="lio_quality/log_en" type="bool" value="$(arg lio_quality_log)" />

	<node pkg="fast_livo" type="fastlivo_mapping" name="laserMappingMulticam" output="screen">
		<param name="multi_camera_enabled" type="bool" value="true" />
	</node>
	<node if="$(arg rviz)" launch-prefix="nice" pkg="rviz" type="rviz" name="rviz" args="-d $(find fast_livo)/rviz_cfg/fast_livo2_muti.rviz" />
</launch>
